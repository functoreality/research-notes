---
import { App } from '../components/App';

const { file: initialFile, line: initialLine } = Astro.url.searchParams;
const initialFileStr = initialFile?.toString() || undefined;
const initialLineNum = initialLine ? parseInt(initialLine.toString(), 10) : undefined;
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>Research Notes</title>
		<meta name="description" content="Personal research notes with hierarchical folding and interlinking" />
		<!-- 访客计数：Vercount 脚本，仅后台统计，前端无可见元素 -->
		<script defer src="https://cn.vercount.one/js"></script>
		<style>
			/* 初始加载提示样式 - 在 CSS 加载前显示 */
			#initial-loading {
				position: fixed;
				inset: 0;
				background-color: #faf9f7;
				display: flex;
				align-items: center;
				justify-content: center;
				z-index: 9999;
			}
			#initial-loading.hidden {
				display: none;
			}
			#initial-loading-content {
				text-align: center;
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				max-width: 320px;
				padding: 20px;
			}
			#initial-loading-spinner {
				font-size: 2rem;
				margin-bottom: 1rem;
				opacity: 0.5;
			}
			#initial-loading-text {
				color: #4a5568;
				font-size: 14px;
				margin-bottom: 0.5rem;
			}
			#initial-loading-hint {
				color: #718096;
				font-size: 13px;
				line-height: 1.6;
			}
			@media (prefers-color-scheme: dark) {
				#initial-loading {
					background-color: #0d1117;
				}
				#initial-loading-text {
					color: #c9d1d9;
				}
				#initial-loading-hint {
					color: #8b949e;
				}
			}
			@keyframes pulse {
				0%, 100% { opacity: 0.4; transform: translateX(0); }
				50% { opacity: 1; transform: translateX(100%); }
			}
		</style>
	</head>
	<body>
		<div id="initial-loading">
			<div id="initial-loading-content">
				<div id="initial-loading-spinner">⋯</div>
				<p id="initial-loading-text">正在努力加载笔记数据</p>
				<p id="initial-loading-hint">数据量大概 11MB，两分钟之内应该能加载好<br/>耐心等我一会儿啦——</p>
			</div>
		</div>
		<div id="root"></div>
		<App 
			client:only="react" 
			initialFile={initialFileStr}
			initialLine={initialLineNum}
		/>
		<!--
			═══════════════════════════════════════════════════════
			访客计数展示 - 如需在主页底部显示统计数据，取消下方注释即可
			数据来源：Vercount (vercount.one)，兼容所有主流浏览器
			═══════════════════════════════════════════════════════
			<div style="text-align:center;padding:1.5rem 1rem;color:#718096;font-size:.85rem;border-top:1px solid #e2e8f0;margin-top:3rem;max-width:800px;margin-left:auto;margin-right:auto">
				<span id="busuanzi_container_site_pv" style="display:none">
					本站总访问量 <span id="busuanzi_value_site_pv"></span> 次
				</span>
				<span id="busuanzi_container_site_uv" style="display:none">
					，访客数 <span id="busuanzi_value_site_uv"></span> 人
				</span>
			</div>
		-->
	</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
