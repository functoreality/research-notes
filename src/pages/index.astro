---
import { App } from '../components/App';
import { loadSiteConfig } from '../../scripts/site-config.mjs';

const siteConfig = loadSiteConfig();
const base = import.meta.env.BASE_URL || '/';
const basePath = base.endsWith('/') ? base : `${base}/`;
---

<html lang={siteConfig.lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{siteConfig.title}</title>
		<meta name="description" content={siteConfig.description} />
		<!-- 访客计数：Vercount 脚本，仅后台统计，前端无可见元素 -->
		<script defer src="https://cn.vercount.one/js"></script>
		<style>
			/* 初始加载提示样式 - 在 CSS 加载前显示 */
			#initial-loading {
				position: fixed;
				inset: 0;
				background-color: #faf9f7;
				display: flex;
				align-items: center;
				justify-content: center;
				z-index: 9999;
			}
			#initial-loading.hidden {
				display: none;
			}
			#initial-loading-content {
				text-align: center;
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				max-width: 320px;
				padding: 20px;
			}
			#initial-loading-spinner {
				font-size: 2rem;
				margin-bottom: 1rem;
				opacity: 0.5;
			}
			#initial-loading-text {
				color: #4a5568;
				font-size: 14px;
				margin-bottom: 0.5rem;
			}
			#initial-loading-hint {
				color: #718096;
				font-size: 13px;
				line-height: 1.6;
				white-space: pre-line;
			}
			@media (prefers-color-scheme: dark) {
				#initial-loading {
					background-color: #0d1117;
				}
				#initial-loading-text {
					color: #c9d1d9;
				}
				#initial-loading-hint {
					color: #8b949e;
				}
			}
			@keyframes pulse {
				0%, 100% { opacity: 0.4; transform: translateX(0); }
				50% { opacity: 1; transform: translateX(100%); }
			}
		</style>
	</head>
	<body>
		<div id="initial-loading">
			<div id="initial-loading-content">
				<div id="initial-loading-spinner">⋯</div>
				<p id="initial-loading-text">正在努力加载笔记数据</p>
				<p id="initial-loading-hint">{siteConfig.loadingHint}</p>
			</div>
		</div>
		<div id="root"></div>
		<App 
			client:only="react" 
			loadingHint={siteConfig.loadingHint}
			siteName={siteConfig.siteName}
			visitorLabel={siteConfig.visitorLabel}
		/>

		<!--
			═══════════════════════════════════════════════════════
			访客计数展示
			数据来源：Vercount，使用 page_pv（按路径独立计数）

			展示模式：默认仅首页展示。如需所有页面展示：
			  1. 注释掉下方 MutationObserver 的 script
			  2. 取消注释 "所有页面展示" 那行 script
			═══════════════════════════════════════════════════════
		-->

		<!-- 静态计数器元素：position:fixed 固定在视口底部，不依赖页面滚动 -->
		<div id="visitor-counter" style="position:fixed;bottom:0;left:0;right:0;text-align:left;padding:0rem 0rem;color:var(--color-text-muted);font-size:.8rem;border-top:1px solid var(--color-paper-line);background:var(--color-paper);z-index:50;display:none">
			<span id="busuanzi_container_page_pv" style="display:none">
				{siteConfig.visitorLabel}是第 <span id="busuanzi_value_page_pv"></span> 次有人来看啦
			</span>
			<!-- 隐藏的 site 级计数器，供 ?stats 统计面板读取 -->
			<span id="busuanzi_container_site_pv" style="display:none;opacity:0">
				<span id="busuanzi_value_site_pv"></span>
			</span>
			<span id="busuanzi_container_site_uv" style="display:none;opacity:0">
				<span id="busuanzi_value_site_uv"></span>
			</span>
		</div>

		<!-- 所有页面展示模式（默认注释，需要时取消） -->
		<!-- <script>document.getElementById('visitor-counter').style.display='block'</script> -->

		<!-- 仅首页展示模式（默认启用，通过检测当前激活标签页判断） -->
		<!-- <script>
			(function() {
				var c = document.getElementById('visitor-counter');
				if (!c) return;
				var check = function() {
					var active = document.querySelector('.tab.active');
					c.style.display = (active && active.textContent.trim() === '⌂') ? 'block' : 'none';
				};
				// 轮询等待 React 渲染完成（最多等 5 秒），然后挂载观察器
				var tries = 0;
				var init = function() {
					var bar = document.querySelector('.header-bar');
					if (bar) {
						check();
						new MutationObserver(check).observe(bar, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });
					} else if (tries++ < 250) {
						setTimeout(init, 20);
					}
				};
				init();
			})();
		</script> -->
	</body>
</html>

<style is:global>
	@import '../styles/global.css';
</style>
